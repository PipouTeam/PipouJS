{
    "name": "backend",
    "version": "1.0.0",
    "description": "backend is the ultimate backend solution",
    "main": "src/server.js",
    "scripts": {
        "setup": "npm install && npm update",
        "start": "node --experimental-vm-modules src/server.js",
        "deploy": "npm install && npm update && node --experimental-vm-modules src/server.js",
        "test": "NODE_OPTIONS='--experimental-vm-modules' jest --forceExit --testPathIgnorePatterns=integration",
        "test:ci": "NODE_OPTIONS='--experimental-vm-modules' jest --forceExit --testPathIgnorePatterns=integration --reporters=default --reporters=jest-junit",
        "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest --forceExit --testMatch='**/tests/integration/**/*.test.js' --runInBand",
        "test:integration:ci": "NODE_OPTIONS='--experimental-vm-modules' jest --forceExit --testMatch='**/tests/integration/**/*.test.js' --runInBand --reporters=default --reporters=jest-junit",
        "test:all": "NODE_OPTIONS='--experimental-vm-modules' jest --forceExit --runInBand",
        "test:docker": "./scripts/test-integration.sh"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/tests/**/*.test.js"
        ]
    },
    "keywords": [
        "express",
        "backend",
        "backend"
    ],
    "license": "UNLICENSED",
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1068.0",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.4",
        "cors": "^2.8.5",
        "express": "^5.2.1",
        "express-custom-error": "^1.8.4",
        "has-keys": "^0.1.0",
        "helmet": "^8.2.0",
        "http-status": "^2.1.0",
        "jsonwebtoken": "^9.0.3",
        "mandatoryenv": "^3.0.4",
        "module-alias": "^2.2.2",
        "morgan": "^1.11.0",
        "multer": "^2.1.1",
        "pg": "^8.21.0",
        "rotating-file-stream": "^3.2.9",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "jest": "^30.4.2",
        "jest-junit": "^17.0.0",
        "supertest": "^7.2.2"
    }
}
